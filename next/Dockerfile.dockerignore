# Build context: next/ (see Dockerfile). Keep Go module dirs listed in go.work.
**/node_modules
**/.vite
**/*.test
**/*.exe
**/.env
**/.env.*
!**/.env.example
deploy/keys
e2e/.cache
# Build output the ui stage makes afresh (deploy/docker/build-ui.sh): a local
# build's files would stay next to the new ones in the image and packages.
server/web/dist/assets
plugins/*/ui/native/dist
.git
