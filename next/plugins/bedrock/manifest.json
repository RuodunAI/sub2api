  "hostPermissions": [
    {
      "id": "platform.register",
      "reason": {
        "en": "Register the AWS Bedrock account types (API key, access key, temporary credentials) for the built-in anthropic and openai platforms",
        "zh": "为内置 anthropic 和 openai 平台注册 AWS Bedrock 账号类型（API Key、Access Key、临时凭证）"
      }
    },
    {
      "id": "accounts.credentials",
      "scope": {
        "types": "own"
      },
      "reason": {
        "en": "Read the API key or access key of its own accounts to build upstream requests and their signing directive (the core signs and sends them)",
        "zh": "读取本插件账号的 API Key 或 Access Key，用于构造上游请求及其签名指令（由核心签名并发送）"
      }
    }
  ],
  "externalServices": [
    "bedrock-runtime.*.amazonaws.com"
  ]
