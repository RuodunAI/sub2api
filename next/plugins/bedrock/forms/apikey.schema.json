{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AWS Bedrock API key",
  "required": [
    "api_key"
  ],
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "type": "string",
      "title": "API key",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^[!-~]+$"
    },
    "region": {
      "type": "string",
      "title": "Region",
      "default": "us-east-1",
      "pattern": "^([a-z]{2}(-[a-z]+)+-\\d)?$"
    },
    "inference_profile_prefix": {
      "type": "string",
      "title": "Cross-region inference prefix",
      "enum": [
        "none",
        "us",
        "eu",
        "apac",
        "jp",
        "au",
        "in",
        "global"
      ],
      "default": "global"
    }
  }
}
