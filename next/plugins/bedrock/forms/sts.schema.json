{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "AWS Bedrock temporary credentials",
  "required": [
    "access_key_id",
    "secret_access_key",
    "session_token"
  ],
  "additionalProperties": false,
  "properties": {
    "access_key_id": {
      "type": "string",
      "title": "Access key ID",
      "pattern": "^[A-Z0-9]{16,128}$"
    },
    "secret_access_key": {
      "type": "string",
      "title": "Secret access key",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[!-~]+$"
    },
    "session_token": {
      "type": "string",
      "title": "Session token",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[!-~]+$"
    },
    "session_expires_at": {
      "type": "string",
      "title": "Credentials expire at",
      "format": "date-time"
    },
    "region": {
      "type": "string",
      "title": "Region",
      "default": "us-east-1",
      "pattern": "^([a-z]{2}(-[a-z]+)+-\\d)?$"
    },
    "inference_profile_prefix": {
      "type": "string",
      "title": "Cross-region inference prefix",
      "enum": [
        "none",
        "us",
        "eu",
        "apac",
        "jp",
        "au",
        "in",
        "global"
      ],
      "default": "global"
    }
  }
}
