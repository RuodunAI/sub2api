{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Azure OpenAI (v1 API)",
  "required": ["base_url", "api_key"],
  "additionalProperties": false,
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Resource endpoint",
      "minLength": 1,
      "pattern": "^https?://[^\\s/?#@]+(/|/openai/?|/openai/v1/?|/api/projects/[^\\s/?#]+/?)?$"
    },
    "api_key": {
      "type": "string",
      "title": "API key",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    }
  }
}
