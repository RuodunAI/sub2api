{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Azure OpenAI (deployments, classic)",
  "required": ["base_url", "api_key", "api_version"],
  "additionalProperties": false,
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Resource endpoint",
      "minLength": 1,
      "pattern": "^https?://[^\\s/?#@]+(/|/openai/?|/openai/v1/?|/api/projects/[^\\s/?#]+/?)?$"
    },
    "api_key": {
      "type": "string",
      "title": "API key",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "api_version": {
      "type": "string",
      "title": "API version",
      "default": "2024-10-21",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(-preview)?$"
    }
  }
}
