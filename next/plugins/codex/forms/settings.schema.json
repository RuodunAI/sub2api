{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ChatGPT (Codex) settings",
  "additionalProperties": false,
  "properties": {
    "user_agent": {
      "type": "string",
      "title": "User-Agent",
      "default": "",
      "pattern": "^[^\\x00-\\x08\\x0A-\\x1F\\x7F]*$"
    },
    "originator": {
      "type": "string",
      "title": "originator",
      "default": "",
      "pattern": "^[^\\x00-\\x08\\x0A-\\x1F\\x7F]*$"
    }
  }
}
