{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Vertex AI service account",
  "required": [
    "service_account_json"
  ],
  "additionalProperties": false,
  "properties": {
    "service_account_json": {
      "type": "string",
      "title": "Service account key",
      "minLength": 2,
      "maxLength": 32768
    },
    "project_id": {
      "type": "string",
      "title": "Project ID",
      "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9])?$"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "default": "global",
      "pattern": "^([a-z0-9-]{2,32})?$"
    },
    "access_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "integer"
    },
    "token_for": {
      "type": "string"
    }
  }
}
