{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Vertex AI API key",
  "required": [
    "api_key"
  ],
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "type": "string",
      "title": "API key",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID",
      "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9])?$"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "pattern": "^([a-z0-9-]{2,32})?$"
    }
  }
}
