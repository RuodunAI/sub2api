-- sql
SELECT g.action, g.role, g.scope FROM (SELECT substr(cr.v0, 3) AS role, cr.v1 AS action, CASE cr.v2 WHEN '*' THEN '' ELSE cr.v2 END AS scope, CASE cr.v2 WHEN '*' THEN cr.v1 ELSE cr.v1 || ':' || cr.v2 END AS key
FROM casbin_rule cr WHERE cr.ptype = 'p' AND cr.v1 <> '*') g JOIN roles r ON r.key = g.role AND NOT r.superuser
WHERE g.action = ANY($1)
ORDER BY 1, 2, 3
-- vars
$1 store.Strings [plugin:demo:read]
