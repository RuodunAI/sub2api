-- sql
SELECT r.id AS role_id, a.id AS assignable_role_id, a.key, ra.role_id IS NOT NULL AS held FROM roles a JOIN roles r ON r.key = $1 LEFT JOIN role_assignable_roles ra ON ra.role_id = r.id AND ra.assignable_role_id = a.id WHERE a.key = ANY($2) AND a.builtin AND NOT a.superuser ORDER BY a.key
-- vars
$1 string "admin"
$2 store.Strings [user]
