-- sql
WITH changed AS (
    DELETE FROM casbin_rule cr USING permissions p, roles r
    WHERE cr.ptype = $1 AND cr.v0 = $2 AND p.key = cr.v1 AND r.key = $3 AND (CAST($4 AS text) = '' OR p.source = $5) AND (CAST($6 AS text) = '' OR p.plugin_key = $7)
    AND (CAST($8 AS text) = '' OR p.key = $9) AND p.status <> ALL(COALESCE(CAST($10 AS text[]), '{}'))
    AND NOT (CAST($11 AS boolean) AND r.superuser)
      AND (cr.v1, cr.v2) NOT IN (SELECT * FROM unnest($12::text[], $13::text[]))
    RETURNING r.id AS role_id)
UPDATE roles SET revision = revision + 1 WHERE id IN (SELECT role_id FROM changed)
-- vars
$1 string "p"
$2 string "r:admin"
$3 string "admin"
$4 string ""
$5 string ""
$6 string "demo"
$7 string "demo"
$8 string "plugin.demo:read"
$9 string "plugin.demo:read"
$10 store.Strings [staged]
$11 bool false
$12 store.Strings [account:read]
$13 store.Strings [*]
