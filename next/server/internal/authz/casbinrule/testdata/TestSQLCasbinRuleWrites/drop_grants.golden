-- sql
SELECT p.key FROM permissions p JOIN roles r ON r.key = $3 WHERE p.plugin_key = $4 AND p.key = $5 AND p.status <> ALL($6)
-- vars
$1 string "p"
$2 string "r:admin"
$3 string "admin"
$4 string "demo"
$5 string "plugin.demo:read"
$6 store.Strings [staged]

-- sql
DELETE FROM "casbin_rule" WHERE (ptype = $1 AND v0 = $2) AND v1 IN (SELECT p.key FROM permissions p JOIN roles r ON r.key = $3 WHERE p.plugin_key = $4 AND p.key = $5 AND p.status <> ALL($6)) AND ("v1","v2") NOT IN (($7,$8))
-- vars
$1 string "p"
$2 string "r:admin"
$3 string "admin"
$4 string "demo"
$5 string "plugin.demo:read"
$6 store.Strings [staged]
$7 string "account:read"
$8 string "*"
