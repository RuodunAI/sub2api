-- sql
INSERT INTO "casbin_rule" ("ptype","v0","v1") VALUES ($1,$2,$3),($4,$5,$6) ON CONFLICT ("ptype","v0","v1","v2","v3","v4","v5") DO NOTHING RETURNING "id","ptype","v0","v1","v2","v3","v4","v5"
-- vars
$1 string "g"
$2 string "u:7"
$3 string "r:admin"
$4 string "g"
$5 string "u:8"
$6 string "r:admin"
