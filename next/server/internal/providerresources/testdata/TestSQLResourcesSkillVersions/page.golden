-- sql
SELECT public_id,remote_id,legacy_epoch,state,operation_id,bytes,metadata,created_at FROM "provider_skill_versions" WHERE (parent_id=$1 AND state='ready') AND (created_at,public_id)<($2,$3) ORDER BY created_at DESC,public_id DESC LIMIT $4
-- vars
$1 string "s2res_1"
$2 time.Time 2026-11-15 08:00:00 +0000 UTC
$3 string "s2skv_9"
$4 int 21
