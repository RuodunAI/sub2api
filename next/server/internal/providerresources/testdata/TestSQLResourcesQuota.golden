-- sql
SELECT count(*), COALESCE(sum(bytes),0) FROM ((SELECT "bytes" FROM "provider_resources" WHERE (user_id = $1 AND group_id = $2 AND state NOT IN ('deleted','failed')) AND (NOT (kind = 'container' AND expires_at IS NOT NULL AND expires_at <= $3))) UNION ALL (SELECT v.bytes FROM provider_skill_versions v JOIN provider_resources p ON p.public_id = v.parent_id WHERE p.user_id = $4 AND p.group_id = $5 AND p.state NOT IN ('deleted','failed') AND v.state NOT IN ('deleted','failed'))) occupied
-- vars
$1 int64 7
$2 int64 3
$3 time.Time 2026-11-15 08:00:00 +0000 UTC
$4 int64 7
$5 int64 3
