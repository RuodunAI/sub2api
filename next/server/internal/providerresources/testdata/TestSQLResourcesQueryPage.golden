-- sql
SELECT public_id,plugin_key,kind,remote_id,state,operation_id,user_id,group_id,account_id,principal_id,generation,bytes,metadata,created_at,expires_at,intent_hash FROM "provider_resources" WHERE user_id=$1 AND group_id=$2 AND plugin_key=$3 AND kind=$4 AND account_id=ANY($5::bigint[]) AND state='ready' AND (expires_at IS NULL OR expires_at>now()-($6 * interval '1 second')) AND public_id=ANY($7::text[]) AND (created_at,public_id)<($8,$9) ORDER BY created_at DESC,public_id DESC LIMIT $10
-- vars
$1 int64 7
$2 int64 3
$3 string "ccgateway"
$4 string "file"
$5 store.Int64s [11 12]
$6 float64 3600
$7 store.Strings [s2res_1]
$8 time.Time 2026-11-15 08:00:00 +0000 UTC
$9 string "s2res_9"
$10 int 21
