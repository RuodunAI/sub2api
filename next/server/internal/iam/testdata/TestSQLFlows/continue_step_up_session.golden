-- sql
UPDATE "auth_flows" SET "expires_at"=LEAST($1, created_at + make_interval(secs => $2)) WHERE token_hash = $3 AND purpose = $4 AND expires_at > now() AND created_at > now() - make_interval(secs => $5)
-- vars
$1 time.Time 2026-11-15 08:00:00 +0000 UTC
$2 float64 1800
$3 string "hash"
$4 string "step_up_session"
$5 float64 1800
