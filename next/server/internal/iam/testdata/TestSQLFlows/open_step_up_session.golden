-- sql
INSERT INTO auth_flows (token_hash, purpose, user_id, payload, expires_at) VALUES ($1, $2, $3, $4, $5)
		ON CONFLICT (token_hash) DO UPDATE SET expires_at = EXCLUDED.expires_at, created_at = now()
-- vars
$1 string "hash"
$2 string "step_up_session"
$3 int64 7
$4 []uint8 [123 34 115 99 111 112 101 34 58 34 120 34 125]
$5 time.Time 2026-11-15 08:00:00 +0000 UTC
