-- sql
SELECT count(*) FROM users u WHERE (($1::boolean OR COALESCE(u.owner_id = ANY($2::bigint[]), false) OR u.id = ANY($3::bigint[]))) AND u.deleted_at IS NULL AND ((u.email ILIKE $4 OR u.display_name ILIKE $5)) AND u.status = $6 AND ($7 IN (SELECT substr(cr.v1, 3) FROM casbin_rule cr WHERE cr.ptype = 'g' AND cr.v0 = ('u:' || u.id))) AND u.segment_id = $8 AND u.owner_id = $9 AND u.owner_id = $10
-- vars
$1 bool false
$2 core.int64s [9 12]
$3 core.int64s []
$4 string "%ann%"
$5 string "%ann%"
$6 string "active"
$7 string "admin"
$8 int64 3
$9 int64 5
$10 int64 9
