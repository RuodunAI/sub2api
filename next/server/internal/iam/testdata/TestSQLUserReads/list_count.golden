-- sql
SELECT count(*) FROM users u WHERE u.deleted_at IS NULL AND ((u.email ILIKE $1 OR u.display_name ILIKE $2)) AND u.status = $3 AND (EXISTS (SELECT 1 FROM user_roles ur JOIN roles r ON r.id = ur.role_id WHERE ur.user_id = u.id AND r.key = $4)) AND u.segment_id = $5
-- vars
$1 string "%ann%"
$2 string "%ann%"
$3 string "active"
$4 string "admin"
$5 int64 3
