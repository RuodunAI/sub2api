-- sql
SELECT u.id, u.email, u.display_name, u.status, u.last_login_at, u.created_at, u.updated_at,
    COALESCE((SELECT array_agg(k ORDER BY k) FROM (SELECT substr(cr.v1, 3) FROM casbin_rule cr WHERE cr.ptype = 'g' AND cr.v0 = ('u:' || u.id)) ur(k)), '{}'),
    s.id, s.kind, CASE WHEN s.user_id IS NULL THEN s.name ELSE u.email END AS name, s.user_id,
    COALESCE((SELECT b.balance FROM user_balances b WHERE b.user_id = u.id), 0)::numeric(20,8)::text FROM users u JOIN segments s ON s.id = u.segment_id WHERE u.deleted_at IS NULL AND ((u.email ILIKE $1 OR u.display_name ILIKE $2)) AND u.status = $3 AND ($4 IN (SELECT substr(cr.v1, 3) FROM casbin_rule cr WHERE cr.ptype = 'g' AND cr.v0 = ('u:' || u.id))) AND u.segment_id = $5 ORDER BY u.id LIMIT $6 OFFSET $7
-- vars
$1 string "%ann%"
$2 string "%ann%"
$3 string "active"
$4 string "admin"
$5 int64 3
$6 int 20
$7 int 20
