-- sql
SELECT u.id, u.email, u.display_name, u.status, u.last_login_at, u.created_at, u.updated_at,
    u.owner_id, (SELECT o.email FROM users o WHERE o.id = u.owner_id),
    COALESCE((SELECT array_agg(k ORDER BY k) FROM (SELECT substr(cr.v1, 3) FROM casbin_rule cr WHERE cr.ptype = 'g' AND cr.v0 = ('u:' || u.id)) ur(k)), '{}'),
    s.id, s.kind, CASE WHEN s.user_id IS NULL THEN s.name ELSE u.email END AS name, s.user_id,
    COALESCE((SELECT b.balance FROM user_balances b WHERE b.user_id = u.id), 0)::numeric(20,8)::text FROM users u JOIN segments s ON s.id = u.segment_id WHERE (($1::boolean OR COALESCE(u.owner_id = ANY($2::bigint[]) OR u.owner_id IN (SELECT "id" FROM "users" WHERE "owner_path" && $3), false) OR u.id = ANY($4::bigint[]))) AND u.deleted_at IS NULL AND ((u.email ILIKE $5 OR u.display_name ILIKE $6)) AND u.status = $7 AND ($8 IN (SELECT substr(cr.v1, 3) FROM casbin_rule cr WHERE cr.ptype = 'g' AND cr.v0 = ('u:' || u.id))) AND u.segment_id = $9 AND u.owner_id = $10 AND u.owner_id = $11 ORDER BY u.id LIMIT $12 OFFSET $13
-- vars
$1 bool false
$2 core.int64s [9]
$3 gormpg.Array[int64] [9]
$4 core.int64s []
$5 string "%ann%"
$6 string "%ann%"
$7 string "active"
$8 string "admin"
$9 int64 3
$10 int64 5
$11 int64 9
$12 int 20
$13 int 20
