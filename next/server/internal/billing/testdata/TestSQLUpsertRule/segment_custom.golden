-- sql
INSERT INTO price_rules (group_id, segment_id, model, kind, multiplier, mode, config, expression, expr_hash, updated_by)
		VALUES ($1, $2, $3, $4, $5::numeric, NULLIF($6, ''), $7, $8, $9, $10)
		ON CONFLICT (group_id, segment_id, model) WHERE segment_id IS NOT NULL DO UPDATE SET kind = EXCLUDED.kind, multiplier = EXCLUDED.multiplier,
			mode = EXCLUDED.mode, config = EXCLUDED.config, expression = EXCLUDED.expression,
			expr_hash = EXCLUDED.expr_hash, updated_by = EXCLUDED.updated_by, updated_at = now()
-- vars
$1 int64 3
$2 *int64 5
$3 string "claude-sonnet-4-5"
$4 string "custom"
$5 *string nil
$6 string "per_request"
$7 map[string]*float64 map[price:<nil>]
$8 string "flat(0.5)"
$9 string "h"
$10 *int64 2
