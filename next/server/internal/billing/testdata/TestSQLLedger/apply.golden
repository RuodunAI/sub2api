-- sql
WITH existing AS (
    SELECT id, balance_after, user_id, delta, kind FROM balance_ledger WHERE idempotency_key = $1::varchar
), locked AS (
    SELECT balance FROM user_balances
    WHERE user_id = $2::bigint AND NOT EXISTS (SELECT 1 FROM existing)
    FOR UPDATE
), ledger AS (
    INSERT INTO balance_ledger (user_id, delta, balance_after, kind, ref_type, ref_id,
        idempotency_key, operator_id, plugin_key, note)
    SELECT $3::bigint, $4::numeric, locked.balance + $5::numeric, $6::text, $7::text, $8::text,
        $9::varchar, $10::bigint, NULLIF($11::text, ''), $12::text
    FROM locked
    ON CONFLICT (idempotency_key) DO NOTHING
    RETURNING id, balance_after
), applied AS (
    UPDATE user_balances SET balance = ledger.balance_after, updated_at = now()
    FROM ledger
    WHERE user_balances.user_id = $13::bigint
    RETURNING ledger.id, ledger.balance_after
)
SELECT COALESCE((SELECT id FROM applied), 0),
       COALESCE((SELECT balance_after FROM applied), 0),
       EXISTS (SELECT 1 FROM existing),
       COALESCE((SELECT id FROM existing), 0),
       COALESCE((SELECT balance_after FROM existing), 0),
       COALESCE((SELECT user_id FROM existing), 0),
       COALESCE((SELECT delta FROM existing), 0),
       COALESCE((SELECT kind FROM existing), '')
-- vars
$1 string "adjust:1"
$2 int64 7
$3 int64 7
$4 decimal.Decimal -0.5
$5 decimal.Decimal -0.5
$6 string "admin_adjust"
$7 string "manual"
$8 string "ref-1"
$9 string "adjust:1"
$10 *int64 9
$11 string ""
$12 string "note"
$13 int64 7
