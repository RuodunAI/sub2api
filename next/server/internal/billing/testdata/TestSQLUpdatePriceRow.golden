-- sql
UPDATE "model_prices" SET "config"=$1,"enabled"=$2,"expr_hash"=$3,"expr_version"=$4,"expression"=$5,"mode"=$6,"model"=$7,"note"=$8,"source"=$9,"sync_source_id"=$10,"updated_at"=now(),"updated_by"=$11 WHERE id = $12
-- vars
$1 jsontext.Value {"p":3}
$2 bool false
$3 string "h"
$4 int 1
$5 string "tokens(3, 15)"
$6 string "per_token"
$7 string "claude-sonnet-4-5"
$8 string ""
$9 string "manual"
$10 *int64 nil
$11 *int64 2
$12 int64 9
