-- sql
SELECT l.id, l.user_id, COALESCE(u.email, '') AS user_email,
		COALESCE(u.display_name, '') AS user_name, l.delta, l.balance_after, l.kind, l.ref_type, l.ref_id,
		l.idempotency_key, l.operator_id, l.plugin_key, l.note, l.created_at FROM balance_ledger l LEFT JOIN users u ON u.id = l.user_id ORDER BY l.id DESC LIMIT $1
-- vars
$1 int 50
