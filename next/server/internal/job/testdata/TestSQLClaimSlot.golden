-- sql
INSERT INTO "plugin_job_runs" ("job_id","manual","node_id","plugin_key","scheduled_at","scope","started_at","status") VALUES ($1,$2,$3,$4,$5,$6,now(),$7) ON CONFLICT ("plugin_key","job_id","scheduled_at")  WHERE NOT manual DO NOTHING RETURNING "id"
-- vars
$1 string "sync"
$2 bool false
$3 string "node-a"
$4 string "demo"
$5 time.Time 2026-11-15 08:00:00 +0000 UTC
$6 string "cluster"
$7 string "running"
