-- sql
INSERT INTO "plugin_job_runs" ("plugin_key","job_id","node_id","scheduled_at","started_at","status","manual","scope") VALUES ($1,$2,$3,$4,now(),$5,$6,$7) ON CONFLICT ("plugin_key","job_id","scheduled_at")  WHERE NOT manual DO NOTHING RETURNING "id"
-- vars
$1 string "demo"
$2 string "sync"
$3 string "node-a"
$4 time.Time 2026-11-15 08:00:00 +0000 UTC
$5 string "running"
$6 bool false
$7 string "cluster"
