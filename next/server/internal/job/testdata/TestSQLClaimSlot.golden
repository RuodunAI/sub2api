-- sql
INSERT INTO plugin_job_runs (plugin_key, job_id, node_id, scheduled_at, started_at, status, manual, scope)
		SELECT $1::varchar, $2::varchar, $3::varchar, $4::timestamptz, now(), $5::varchar, false, $6
		WHERE NOT EXISTS (SELECT 1 FROM plugin_job_runs
			WHERE plugin_key = $7 AND job_id = $8 AND scheduled_at = $9 AND NOT manual)
		RETURNING id
-- vars
$1 string "demo"
$2 string "sync"
$3 string "node-a"
$4 time.Time 2026-11-15 08:00:00 +0000 UTC
$5 string "running"
$6 string "cluster"
$7 string "demo"
$8 string "sync"
$9 time.Time 2026-11-15 08:00:00 +0000 UTC
