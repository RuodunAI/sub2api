-- sql
SELECT p.id, p.name, p.protocol, p.host, p.port, p.username, p.password_enc IS NOT NULL AS has_password,
	p.status, (SELECT count(*) FROM accounts a WHERE a.proxy_id = p.id AND a.deleted_at IS NULL
	  AND ($1::text[] IS NULL OR a.plugin_key = ANY($2))) AS account_count,
	p.created_by, u.email AS created_by_email, p.created_at, p.updated_at, p.real_ip, p.real_ip_updated_at FROM proxies p LEFT JOIN users u ON u.id = p.created_by WHERE p.id = $3 AND (($4::boolean OR COALESCE(p.created_by = $5::bigint, false) OR p.id = ANY($6::bigint[]))) LIMIT $7
-- vars
$1 store.Strings [openai]
$2 store.Strings [openai]
$3 int64 5
$4 bool false
$5 int64 7
$6 core.int64s [3 4]
$7 int 1
