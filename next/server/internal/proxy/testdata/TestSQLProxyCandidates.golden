-- sql
SELECT p.id, p.password_enc FROM proxies p WHERE (p.protocol = $1 AND lower(p.host) = $2 AND p.port = $3 AND p.username = $4) AND ((p.password_enc IS NULL) = $5 AND p.status <> 'disabled') AND (($6::boolean OR COALESCE(p.created_by = $7::bigint, false) OR p.id = ANY($8::bigint[]))) ORDER BY p.id
-- vars
$1 string "http"
$2 string "proxy.example"
$3 int 3128
$4 string "u"
$5 bool false
$6 bool false
$7 int64 7
$8 store.Int64s [3 4]
