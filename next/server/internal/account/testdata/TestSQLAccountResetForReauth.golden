-- sql
UPDATE "accounts" SET "auto_disabled_until"=CASE WHEN NOT $1 AND status = 'auto_disabled' THEN auto_disabled_until END,"deferred_auto_disable"=$2,"deferred_auto_disable_reason"=$3,"deferred_auto_disabled_until"=$4,"last_test_at"=$5,"last_test_error_code"=$6,"last_test_error_source"=$7,"last_test_latency_ms"=$8,"last_test_message"=$9,"last_test_model"=$10,"last_test_ok"=$11,"last_test_status"=$12,"status"=CASE WHEN $13 THEN 'active' ELSE status END,"status_reason"=CASE WHEN $14 THEN '' ELSE status_reason END,"updated_at"=clock_timestamp() WHERE id = $15
-- vars
$1 bool true
$2 bool false
$3 string ""
$4 nil
$5 nil
$6 nil
$7 nil
$8 nil
$9 nil
$10 nil
$11 nil
$12 nil
$13 bool true
$14 bool true
$15 int64 5
