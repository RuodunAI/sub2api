-- sql
SELECT count(*) FROM accounts a WHERE a.deleted_at IS NULL AND (($1::boolean OR COALESCE(a.owner_id = ANY($2::bigint[]), false) OR a.id = ANY($3::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($4::boolean OR ag.group_id = ANY($5::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($6::bigint[], $7::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) AND a.plugin_key = ANY($8) AND ((a.status = $9 OR (a.status = 'active' AND NOT a.schedulable))) AND a.id = ANY($10) AND a.name ILIKE '%' || $11 || '%'
-- vars
$1 bool false
$2 core.int64s [7]
$3 core.int64s [3 4]
$4 bool false
$5 core.int64s [9]
$6 core.int64s []
$7 core.int64s []
$8 store.Strings [anthropic openai]
$9 string "auto_disabled"
$10 store.Int64s [3 4]
$11 string "prod"
