-- sql
SELECT count(*) FROM accounts a WHERE a.deleted_at IS NULL AND (($1::boolean OR COALESCE(a.owner_id = ANY($2::bigint[]) OR a.owner_id IN (SELECT "id" FROM "users" WHERE "owner_path" && $3), false) OR a.id = ANY($4::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($5::boolean OR ag.group_id = ANY($6::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($7::bigint[], $8::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) AND a.plugin_key = ANY($9) AND ((a.status = $10 OR (a.status = 'active' AND NOT a.schedulable))) AND a.id = ANY($11) AND a.name ILIKE '%' || $12 || '%'
-- vars
$1 bool false
$2 core.int64s [7]
$3 gormpg.Array[int64] []
$4 core.int64s [3 4]
$5 bool false
$6 core.int64s [9]
$7 core.int64s []
$8 core.int64s []
$9 store.Strings [anthropic openai]
$10 string "auto_disabled"
$11 store.Int64s [3 4]
$12 string "prod"
