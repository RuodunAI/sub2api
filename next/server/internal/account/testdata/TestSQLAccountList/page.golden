	a.last_test_status,a.last_test_error_code,a.last_test_error_source,a.subscription_type,a.rate_limit_tier,a.auto_models,a.auto_disabled_source,a.header_passthrough,a.param_override,a.conversion_loss_policy,a.admin_locked, (SELECT count(*) FROM accounts a WHERE a.deleted_at IS NULL AND (($1::boolean OR COALESCE(a.created_by = $2::bigint, false) OR a.id = ANY($3::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($4::boolean OR ag.group_id = ANY($5::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($6::bigint[], $7::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) AND a.plugin_key = ANY($8) AND ((a.status = $9 OR (a.status = 'active' AND NOT a.schedulable))) AND a.id = ANY($10) AND a.name ILIKE '%' || $11 || '%') FROM accounts a LEFT JOIN users u ON u.id = a.created_by WHERE a.deleted_at IS NULL AND (($12::boolean OR COALESCE(a.created_by = $13::bigint, false) OR a.id = ANY($14::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($15::boolean OR ag.group_id = ANY($16::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($17::bigint[], $18::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) AND a.plugin_key = ANY($19) AND ((a.status = $20 OR (a.status = 'active' AND NOT a.schedulable))) AND a.id = ANY($21) AND a.name ILIKE '%' || $22 || '%' ORDER BY a.created_at DESC, a.id DESC LIMIT $23 OFFSET $24
