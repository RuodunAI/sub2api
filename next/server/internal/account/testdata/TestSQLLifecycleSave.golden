-- sql
INSERT INTO account_lifecycle_sync(account_id,status,code) SELECT id,$1,$2 FROM accounts WHERE id=$3 AND updated_at=$4 ON CONFLICT (account_id) DO UPDATE SET status=EXCLUDED.status,code=EXCLUDED.code,updated_at=now() WHERE account_lifecycle_sync.generation=$5
-- vars
$1 string "applied"
$2 string ""
$3 int64 5
$4 time.Time 2026-11-15 12:00:00 +0000 UTC
$5 int64 3
