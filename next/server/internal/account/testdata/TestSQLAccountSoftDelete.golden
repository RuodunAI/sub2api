-- sql
UPDATE accounts a SET "deleted_at"=now(),"updated_at"=now() WHERE (a.id = $1 AND a.deleted_at IS NULL) AND (($2::boolean OR COALESCE(a.created_by = $3::bigint, false) OR a.id = ANY($4::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($5::boolean OR ag.group_id = ANY($6::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($7::bigint[], $8::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) RETURNING "plugin_key","type","name"
-- vars
$1 int64 5
$2 bool false
$3 int64 7
$4 core.int64s [3 4]
$5 bool false
$6 core.int64s [9]
$7 core.int64s []
$8 core.int64s []
