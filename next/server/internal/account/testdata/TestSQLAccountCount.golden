-- sql
SELECT count(*) AS total, count(*) FILTER (WHERE a.status = 'active' AND a.schedulable) AS available,
		count(*) FILTER (WHERE a.status IN ('auto_disabled', 'error') OR (a.status = 'active' AND NOT a.schedulable)) AS auto_disabled,
		count(*) FILTER (WHERE a.status = 'disabled') AS disabled FROM accounts a WHERE a.deleted_at IS NULL AND (($1::boolean OR COALESCE(a.created_by = $2::bigint, false) OR a.id = ANY($3::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($4::boolean OR ag.group_id = ANY($5::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($6::bigint[], $7::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id)))
-- vars
$1 bool false
$2 int64 7
$3 store.Int64s [3 4]
$4 bool false
$5 store.Int64s [9]
$6 store.Int64s []
$7 store.Int64s []
