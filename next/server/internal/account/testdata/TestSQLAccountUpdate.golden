-- sql
UPDATE accounts a SET "admin_locked"=$1,"auto_disable"=$2,"auto_disabled_until"=$3,"environment"=$4,"priority"=$5,"proxy_id"=$6,"schedulable"=$7,"status"=$8,"status_reason"=$9,"updated_at"=clock_timestamp() WHERE a.id = $10 AND (($11::boolean OR COALESCE(a.created_by = $12::bigint, false) OR a.id = ANY($13::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($14::boolean OR ag.group_id = ANY($15::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($16::bigint[], $17::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id)))
-- vars
$1 bool false
$2 bool false
$3 nil
$4 store.JSON[github.com/Sub2API-Devs/sup2api/next/server/internal/core.EnvironmentValues] {map[relay_timeout_seconds:60]}
$5 int 0
$6 *int64 nil
$7 bool false
$8 string "active"
$9 string ""
$10 int64 5
$11 bool false
$12 int64 7
$13 core.int64s [3 4]
$14 bool false
$15 core.int64s [9]
$16 core.int64s []
$17 core.int64s []
