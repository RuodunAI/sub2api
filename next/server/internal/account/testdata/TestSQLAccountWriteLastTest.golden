-- sql
UPDATE "accounts" SET "last_test_at"=now(),"last_test_error_code"=$1,"last_test_error_source"=$2,"last_test_latency_ms"=$3,"last_test_message"=$4,"last_test_model"=$5,"last_test_ok"=$6,"last_test_status"=$7 WHERE id = $8
-- vars
$1 string "auth"
$2 string "response"
$3 int64 12
$4 string "denied"
$5 string "m"
$6 bool false
$7 int 401
$8 int64 5
