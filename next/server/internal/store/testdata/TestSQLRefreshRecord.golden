-- sql
INSERT INTO "account_credential_refresh" ("account_id","error","error_type","expires_at","last_attempt_at","last_success_at","rejected_cred_hash") VALUES ($1,$2,$3,$4,now(),CASE WHEN $5 = '' THEN now() END,$6) ON CONFLICT ("account_id") DO UPDATE SET "last_attempt_at"="excluded"."last_attempt_at","error_type"="excluded"."error_type","error"="excluded"."error","rejected_cred_hash"="excluded"."rejected_cred_hash","expires_at"=COALESCE(EXCLUDED.expires_at, account_credential_refresh.expires_at),"last_success_at"=COALESCE(EXCLUDED.last_success_at, account_credential_refresh.last_success_at)
-- vars
$1 int64 11
$2 string "boom"
$3 string "transient"
$4 *time.Time 2026-11-15 12:00:00 +0000 UTC
$5 string "transient"
$6 []uint8 [1 2]
