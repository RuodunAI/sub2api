-- sql
INSERT INTO "account_credential_refresh" ("account_id","expires_at","last_attempt_at","last_success_at","error_type","error","rejected_cred_hash") VALUES ($1,$2,now(),$3,$4,$5,$6) ON CONFLICT ("account_id") DO UPDATE SET "last_attempt_at"="excluded"."last_attempt_at","error_type"="excluded"."error_type","error"="excluded"."error","rejected_cred_hash"="excluded"."rejected_cred_hash","expires_at"=COALESCE(EXCLUDED.expires_at, account_credential_refresh.expires_at),"last_success_at"=COALESCE(EXCLUDED.last_success_at, account_credential_refresh.last_success_at)
-- vars
$1 int64 11
$2 *time.Time 2026-11-15 12:00:00 +0000 UTC
$3 nil
$4 string "transient"
$5 string "boom"
$6 []uint8 [1 2]
