-- sql
INSERT INTO account_quota_snapshots
			(account_id, windows, source, error, updated_at, last_passive_at, revision, refresh_status, next_check_at)
		SELECT $1::bigint, $2::jsonb, $3::text, '', clock_timestamp(), CASE WHEN $4::text = 'passive' THEN clock_timestamp() END, 1, 'ready', $5::timestamptz
		WHERE EXISTS (SELECT 1 FROM accounts WHERE id = $6 AND deleted_at IS NULL)
		ON CONFLICT (account_id) DO UPDATE SET
			windows = account_quota_snapshots.windows || EXCLUDED.windows,
			source = EXCLUDED.source,
			error = '',
			updated_at = clock_timestamp(),
			revision = account_quota_snapshots.revision + 1,
			refresh_status = 'ready',
			next_check_at = CASE WHEN account_quota_snapshots.auto_refresh AND $7::timestamptz IS NOT NULL THEN LEAST(account_quota_snapshots.next_check_at,$8::timestamptz) ELSE account_quota_snapshots.next_check_at END,
			last_passive_at = COALESCE(EXCLUDED.last_passive_at, account_quota_snapshots.last_passive_at)
-- vars
$1 int64 11
$2 string "{\"5h\":{}}"
$3 string "passive"
$4 string "passive"
$5 *time.Time 2026-11-15 12:00:00 +0000 UTC
$6 int64 11
$7 *time.Time 2026-11-15 12:00:00 +0000 UTC
$8 *time.Time 2026-11-15 12:00:00 +0000 UTC
