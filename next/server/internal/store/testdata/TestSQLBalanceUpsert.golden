-- sql
INSERT INTO "account_balances" ("account_id","amount_micros","currency","error","error_at","source","updated_at") VALUES ($1,$2,$3,$4,$5,$6,$7) ON CONFLICT ("account_id") DO UPDATE SET "amount_micros"="excluded"."amount_micros","currency"="excluded"."currency","source"="excluded"."source","updated_at"="excluded"."updated_at","error"="excluded"."error","error_at"="excluded"."error_at"
-- vars
$1 int64 11
$2 int64 5
$3 string "USD"
$4 string ""
$5 *time.Time nil
$6 string "active"
$7 *time.Time 2026-11-15 12:00:00 +0000 UTC
