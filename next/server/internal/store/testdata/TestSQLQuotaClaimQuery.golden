-- sql
INSERT INTO "account_quota_snapshots" ("account_id","last_active_at") SELECT id, now() FROM "accounts" WHERE id = $1 ON CONFLICT ("account_id") DO UPDATE SET "last_active_at"=now() WHERE account_quota_snapshots.last_active_at IS NULL
			OR account_quota_snapshots.last_active_at <= now() - make_interval(secs => $2::float8)
-- vars
$1 int64 11
$2 float64 2.5
