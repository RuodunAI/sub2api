-- sql
UPDATE account_quota_snapshots q SET
		windows=CASE WHEN $1='' AND revision=$2 THEN windows||$3::jsonb ELSE windows END,
		source=CASE WHEN $4='' AND revision=$5 THEN 'active' ELSE source END,
		updated_at=CASE WHEN $6='' AND revision=$7 THEN clock_timestamp() ELSE updated_at END,
		error=CASE WHEN revision=$8 THEN $9 ELSE error END,
		refresh_status=CASE WHEN revision<>$10 THEN refresh_status WHEN $11='' THEN 'ready' ELSE 'error' END,
		failures=CASE WHEN revision<>$12 THEN failures WHEN $13='' THEN 0 ELSE LEAST(failures+1,10) END,
		next_check_at=CASE WHEN revision<>$14 THEN next_check_at ELSE $15::timestamptz END,lease_until=NULL,revision=revision+1
		WHERE account_id=$16 AND generation=$17 AND lease_token=$18 AND lease_until>clock_timestamp()
		AND EXISTS(SELECT 1 FROM accounts a WHERE a.id=q.account_id AND a.deleted_at IS NULL
		AND NOT EXISTS(SELECT 1 FROM plugins p WHERE p.key=a.plugin_key AND p.status NOT IN ('enabled','upgrading')))
-- vars
$1 string "boom"
$2 int64 44
$3 string "{\"5h\":{}}"
$4 string "boom"
$5 int64 44
$6 string "boom"
$7 int64 44
$8 int64 44
$9 string "boom"
$10 int64 44
$11 string "boom"
$12 int64 44
$13 string "boom"
$14 int64 44
$15 time.Time 2026-11-15 12:00:00 +0000 UTC
$16 int64 11
$17 int64 22
$18 int64 33
