-- sql
INSERT INTO "account_quota_snapshots" ("account_id","plugin_revision","auto_refresh","next_check_at") SELECT id, $1, $2, CASE WHEN $3 THEN now() END FROM "accounts" WHERE id = $4 AND deleted_at IS NULL ON CONFLICT ("account_id") DO UPDATE SET "auto_refresh"=$5,"generation"=CASE WHEN account_quota_snapshots.plugin_revision<>$6 THEN nextval('account_quota_generation_seq') ELSE account_quota_snapshots.generation END,"lease_until"=CASE WHEN account_quota_snapshots.plugin_revision<>$7 THEN NULL ELSE account_quota_snapshots.lease_until END,"next_check_at"=CASE WHEN NOT $8 THEN NULL WHEN account_quota_snapshots.plugin_revision<>$9 THEN now() ELSE COALESCE(account_quota_snapshots.next_check_at,now()) END,"plugin_revision"=$10,"revision"=account_quota_snapshots.revision+1 WHERE account_quota_snapshots.plugin_revision<>$11 OR account_quota_snapshots.auto_refresh<>$12
-- vars
$1 string "v1"
$2 bool true
$3 bool true
$4 int64 11
$5 bool true
$6 string "v1"
$7 string "v1"
$8 bool true
$9 string "v1"
$10 string "v1"
$11 string "v1"
$12 bool true
