-- sql
WITH r AS MATERIALIZED (SELECT nextval('plugin_egress_logs_id_seq') AS id, u.* FROM unnest($1::text[], $2::text[], $3::text[], $4::text[], $5::int[], $6::timestamptz[], $7::int[], $8::bigint[], $9::bigint[], $10::text[], $11::text[], $12::timestamptz[])
		WITH ORDINALITY AS u(plugin_key, node_id, network, host, port, started_at, duration_ms, bytes_in, bytes_out, result, error, closed_at, ord)),
	ins AS (INSERT INTO plugin_egress_logs (id, plugin_key, node_id, network, host, port, started_at, duration_ms, bytes_in, bytes_out, result, error, closed_at) SELECT id, plugin_key, node_id, network, host, port, started_at, duration_ms, bytes_in, bytes_out, result, error, closed_at FROM r)
	SELECT id FROM r ORDER BY ord
-- vars
$1 store.Strings [demo]
$2 store.Strings [node-1]
$3 store.Strings [tcp]
$4 store.Strings [api.example.com]
$5 store.Int64s [443]
$6 store.Times [2026-11-15 08:00:00 +0000 UTC]
$7 store.Int64s [0]
$8 store.Int64s [0]
$9 store.Int64s [0]
$10 store.Strings [open]
$11 store.Strings []
$12 gormpg.Array[*time.Time] [NULL]
