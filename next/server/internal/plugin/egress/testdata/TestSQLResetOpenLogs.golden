-- sql
UPDATE "plugin_egress_logs" SET "closed_at"=now(),"duration_ms"=LEAST(EXTRACT(EPOCH FROM (now() - started_at)) * 1000, 2147483647)::int,"error"=$1,"result"=$2 WHERE result = 'open' AND node_id = $3 AND started_at < $4
-- vars
$1 string "node restarted"
$2 string "reset"
$3 string "node-1"
$4 time.Time 2026-11-15 08:00:00 +0000 UTC
