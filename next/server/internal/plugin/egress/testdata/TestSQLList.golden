-- sql
SELECT id, node_id, network, host, port, started_at, closed_at, duration_ms, bytes_in, bytes_out, result, error FROM "plugin_egress_logs" WHERE plugin_key = $1 AND started_at >= $2 AND started_at < $3 ORDER BY started_at DESC, id DESC LIMIT $4
-- vars
$1 string "demo"
$2 time.Time 2026-11-15 08:00:00 +0000 UTC
$3 time.Time 2026-11-15 09:00:00 +0000 UTC
$4 int 200
