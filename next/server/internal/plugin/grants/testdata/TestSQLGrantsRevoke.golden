-- sql
UPDATE "plugin_permission_grants" SET "granted_at"=now(),"granted_by"=$1,"status"=$2 WHERE plugin_key = $3 AND permission = $4 AND status = 'granted'
-- vars
$1 *int64 7
$2 string "revoked"
$3 string "demo"
$4 string "kv"

-- sql
UPDATE "plugin_staged_grants" SET "granted_at"=now(),"granted_by"=$1,"status"=$2 WHERE plugin_key = $3 AND permission = $4 AND status = 'granted'
-- vars
$1 *int64 7
$2 string "revoked"
$3 string "demo"
$4 string "kv"
