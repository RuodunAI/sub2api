-- sql
(SELECT 1 FROM "plugin_staged_grants" WHERE plugin_key = $1 AND version = $2 AND permission = $3 AND status = 'granted') UNION ALL (SELECT 1 FROM "plugin_permission_grants" WHERE plugin_key = $4 AND NOT EXISTS (
	SELECT 1 FROM plugin_staged_grants WHERE plugin_key = $5 AND version = $6) AND permission = $7 AND status = 'granted')
-- vars
$1 string "demo"
$2 string "1.2.0"
$3 string "kv"
$4 string "demo"
$5 string "demo"
$6 string "1.2.0"
$7 string "kv"
