-- sql
INSERT INTO "plugin_staged_grants" ("granted_at","granted_by","manifest_hash","permission","plugin_key","scope","status","version") VALUES (now(),$1,$2,$3,$4,$5,$6,$7) ON CONFLICT ("plugin_key","version","permission") DO UPDATE SET "scope"="excluded"."scope","status"="excluded"."status","manifest_hash"="excluded"."manifest_hash","granted_by"="excluded"."granted_by","granted_at"=now()
-- vars
$1 *int64 7
$2 string "hash"
$3 string "kv"
$4 string "demo"
$5 []uint8 [123 34 112 114 101 102 105 120 34 58 34 97 34 125]
$6 string "granted"
$7 string "1.2.0"
