-- sql
UPDATE plugin_rollout_cleanup n SET state='cleaned',updated_at=now()
		FROM plugin_rollouts r,plugins p WHERE n.rollout_id=r.id AND r.plugin_key=p.key
		AND p.key=$1 AND p.row_version=$2 AND n.boot_id=$3 AND n.state='cleanup_pending'
		AND r.phase NOT IN ('preparing','activating')
-- vars
$1 string "demo"
$2 int64 7
$3 string "boot-a"
