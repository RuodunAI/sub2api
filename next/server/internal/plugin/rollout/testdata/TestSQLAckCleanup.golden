-- sql
UPDATE "plugin_rollout_cleanup" SET "state"=$1,"updated_at"=now() WHERE rollout_id IN (SELECT r.id FROM plugin_rollouts AS r JOIN plugins p ON p.key = r.plugin_key WHERE p.key = $2 AND p.row_version = $3 AND r.phase NOT IN ('preparing', 'activating')) AND boot_id = $4 AND state = 'cleanup_pending'
-- vars
$1 string "cleaned"
$2 string "demo"
$3 int64 7
$4 string "boot-a"
