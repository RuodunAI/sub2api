-- sql
SELECT id, plugin_key, action, from_version, target_version, phase,
	COALESCE(coordinator_node_id, '') AS coord_node, COALESCE(coordinator_boot_id, '') AS coord_boot,
	(coordinator_lease_until IS NULL OR coordinator_lease_until < clock_timestamp()) AS lease_expired,
	error, row_version,
	EXTRACT(EPOCH FROM now() - created_at)::float8 AS age_sec, EXTRACT(EPOCH FROM now() - updated_at)::float8 AS phase_age_sec FROM "plugin_rollouts" WHERE id = $1 LIMIT $2
-- vars
$1 int64 42
$2 int 1
