-- sql
INSERT INTO "plugin_rollout_nodes" ("boot_id","error","node_id","rollout_id","state") VALUES ($1,$2,$3,$4,$5) ON CONFLICT ("rollout_id","boot_id") DO UPDATE SET "state"="excluded"."state","error"="excluded"."error","updated_at"=now()
-- vars
$1 string "boot-a"
$2 string "not ready"
$3 string "node-a"
$4 int64 42
$5 string "failed"
