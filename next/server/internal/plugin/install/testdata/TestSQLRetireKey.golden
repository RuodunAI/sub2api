-- sql
INSERT INTO "plugin_key_retirements" ("plugin_key","publisher_id","retired_by") VALUES ($1,(SELECT "publisher_id" FROM "plugins" WHERE key = $2),$3) ON CONFLICT ("plugin_key") DO UPDATE SET "publisher_id"="excluded"."publisher_id","retired_by"="excluded"."retired_by","retired_at"=now()
-- vars
$1 string "demo"
$2 string "demo"
$3 *int64 7
