-- sql
SELECT status, active_version, EXISTS (SELECT 1 FROM plugin_versions AS v WHERE v.plugin_key = plugins.key AND v.version = $1 AND v.consent_status = 'approved'), EXISTS (SELECT 1 FROM plugin_versions AS v WHERE v.plugin_key = plugins.key AND v.version = plugins.active_version AND v.consent_status = 'approved'), EXISTS (SELECT 1 FROM plugin_versions AS v WHERE v.plugin_key = plugins.key AND v.version = $2 AND v.consent_status = 'approved') FROM "plugins" WHERE key = $3 AND builtin
-- vars
$1 string "1.2.0"
$2 string "1.1.0"
$3 string "demo"
