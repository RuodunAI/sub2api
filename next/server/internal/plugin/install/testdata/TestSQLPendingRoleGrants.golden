-- sql
SELECT a.detail->>'version' AS version, g->>'permission' AS permission, g->>'role' AS role,
			COALESCE(g->>'scope', '') AS scope, COALESCE(g->>'via', '') AS via,
			COALESCE((g->>'needs_consent')::boolean, true) AS needs_consent FROM audit_logs AS a CROSS JOIN LATERAL jsonb_array_elements(a.detail->'pending') g WHERE (a.action = ANY($1) AND a.target_type = 'plugin' AND a.target_id = $2) AND jsonb_typeof(a.detail->'pending') = 'array' AND a.created_at >= (SELECT "installed_at" FROM "plugins" WHERE key = $3) AND NOT EXISTS (SELECT 1 FROM audit_logs AS b WHERE (b.target_type = 'plugin' AND b.target_id = a.target_id AND b.action = ANY($4) AND b.id > a.id) AND (b.detail->>'version' = a.detail->>'version'
			OR (b.action = $5 AND b.detail->'grants' @> jsonb_build_array(jsonb_build_object('permission', g->>'permission', 'role', g->>'role'))))) AND EXISTS (SELECT 1 FROM "roles" WHERE roles.key = g->>'role' AND NOT roles.superuser) AND a.detail->>'version' = $6 ORDER BY a.id, 2, 3, 4
-- vars
$1 store.Strings [plugin.consent.auto plugin.consent plugin.role_grants.carry]
$2 string "demo"
$3 string "demo"
$4 store.Strings [plugin.role_grants.confirm plugin.role_grants.reject]
$5 string "plugin.role_grants.reject"
$6 string "1.2.0"
