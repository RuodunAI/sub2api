-- sql
INSERT INTO plugin_uninstalls(plugin_key,epoch,target_boot_ids)
			VALUES($1::text,$2,ARRAY(SELECT DISTINCT unnest($3::text[] || ARRAY(SELECT boot_id FROM plugin_runtime_nodes WHERE plugin_key=$4::text AND NOT stopped)))) ON CONFLICT DO NOTHING
-- vars
$1 string "demo"
$2 int64 5
$3 store.Strings [boot-a]
$4 string "demo"
