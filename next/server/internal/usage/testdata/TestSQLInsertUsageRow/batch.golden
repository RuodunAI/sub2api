-- sql
INSERT INTO usage_logs (request_id, user_id, api_key_id, group_id, account_id, plugin_key, plugin_version, platform, protocol, endpoint, model, upstream_model, stream, status_code, success, error_type, error_message, attempts, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens, cache_creation_1h_tokens, metrics, sticky_rule, sticky_hit, hook_decisions, rate_multiplier, price_id, expr_hash, billing_mode, billing_detail, billing_status, latency_ms, first_token_ms, client_ip, user_agent, node_id, created_at, account_type, upstream_protocol, client_request_id, sched_decisions, plugin_detail, anomalies, upload_ms, conversion)
			SELECT request_id, user_id, api_key_id, group_id, account_id, plugin_key, plugin_version, platform, protocol, endpoint, model, upstream_model, stream, status_code, success, error_type, error_message, attempts, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens, cache_creation_1h_tokens, metrics, sticky_rule, sticky_hit, hook_decisions, rate_multiplier, price_id, expr_hash, billing_mode, billing_detail, billing_status, latency_ms, first_token_ms, client_ip, user_agent, node_id, created_at, account_type, upstream_protocol, client_request_id, sched_decisions, plugin_detail, anomalies, upload_ms, conversion
			FROM unnest($1::varchar[], $2::bigint[], $3::bigint[], $4::bigint[], $5::bigint[], $6::varchar[], $7::varchar[], $8::varchar[], $9::varchar[], $10::varchar[], $11::varchar[], $12::varchar[], $13::boolean[], $14::integer[], $15::boolean[], $16::varchar[], $17::text[], $18::integer[], $19::bigint[], $20::bigint[], $21::bigint[], $22::bigint[], $23::bigint[], $24::jsonb[], $25::varchar[], $26::boolean[], $27::jsonb[], $28::numeric[], $29::bigint[], $30::varchar[], $31::varchar[], $32::jsonb[], $33::varchar[], $34::integer[], $35::integer[], $36::varchar[], $37::varchar[], $38::varchar[], $39::timestamptz[], $40::varchar[], $41::varchar[], $42::varchar[], $43::jsonb[], $44::jsonb[], $45::jsonb[], $46::integer[], $47::jsonb[]) WITH ORDINALITY AS r(request_id, user_id, api_key_id, group_id, account_id, plugin_key, plugin_version, platform, protocol, endpoint, model, upstream_model, stream, status_code, success, error_type, error_message, attempts, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens, cache_creation_1h_tokens, metrics, sticky_rule, sticky_hit, hook_decisions, rate_multiplier, price_id, expr_hash, billing_mode, billing_detail, billing_status, latency_ms, first_token_ms, client_ip, user_agent, node_id, created_at, account_type, upstream_protocol, client_request_id, sched_decisions, plugin_detail, anomalies, upload_ms, conversion, ord)
			ORDER BY ord
			ON CONFLICT (request_id) DO NOTHING
			RETURNING id, request_id
