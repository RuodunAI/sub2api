-- sql
UPDATE task_submission_receipts SET state=$1, response_status=$2,
		response_body=COALESCE( $3,response_body), last_error=$4 WHERE request_id=$5 AND state <> 'registered'
-- vars
$1 string "received"
$2 int 200
$3 []uint8 [123 34 105 100 34 58 34 117 112 45 49 34 125]
$4 string ""
$5 string "req-1"
