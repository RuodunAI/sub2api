-- sql
SELECT count(*) FILTER (WHERE u.success),
			COALESCE(sum(CASE WHEN u.billing_detail->'inputs'->>'semantics' = 'inclusive'
		THEN GREATEST(u.input_tokens - u.cache_read_tokens - u.cache_creation_tokens - u.cache_creation_1h_tokens, 0)
		ELSE u.input_tokens END + u.output_tokens) FILTER (WHERE u.success), 0),
			count(*) FILTER (WHERE NOT u.success AND u.status_code <> 400 AND u.error_type NOT IN
		('client_canceled', 'rate_limited', 'invalid_request', 'insufficient_balance',
		 'key_quota_exhausted', 'model_not_allowed', 'blocked_by_hook'))
			FROM usage_logs u WHERE u.user_id = $1 AND u.model = $2 AND u.created_at >= $3 AND u.created_at + u.latency_ms * interval '1 millisecond' >= $4 AND u.protocol NOT LIKE '%.count_tokens'
-- vars
$1 int64 7
$2 string "claude"
$3 time.Time 2026-11-15 07:00:00 +0000 UTC
$4 time.Time 2026-11-15 07:59:00 +0000 UTC
