-- sql
INSERT INTO usage_hourly (created_at, user_id, api_key_id, group_id, account_id, model, upstream_model, protocol, platform, requests, success, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, total_cost, standard_cost, prompt_rows, prompt_tokens, anomalous_rows, estimated_rows, estimated_cost, latency_sum, latency_rows, first_token_sum, first_token_rows)
		SELECT date_trunc('hour', u.created_at, 'UTC'), user_id, api_key_id, group_id, account_id, model, upstream_model, protocol, platform, sum(1), sum(CASE WHEN u.success THEN 1 ELSE 0 END), sum(u.input_tokens), sum(u.output_tokens), sum(u.cache_read_tokens), sum(u.cache_creation_tokens + u.cache_creation_1h_tokens), sum(u.total_cost), sum(COALESCE(u.base_cost, CASE WHEN u.rate_multiplier > 0 THEN u.total_cost / u.rate_multiplier ELSE u.total_cost END)), sum(CASE WHEN (CASE
		WHEN u.cache_read_tokens + u.cache_creation_tokens + u.cache_creation_1h_tokens = 0 THEN u.input_tokens
		WHEN u.billing_detail->'inputs'->>'semantics' = 'inclusive' THEN u.input_tokens
		WHEN u.billing_detail->'inputs'->>'semantics' IN ('exclusive', '') THEN
			u.input_tokens + u.cache_read_tokens + u.cache_creation_tokens + u.cache_creation_1h_tokens
		END) IS NOT NULL THEN 1 ELSE 0 END), sum(COALESCE(CASE
		WHEN u.cache_read_tokens + u.cache_creation_tokens + u.cache_creation_1h_tokens = 0 THEN u.input_tokens
		WHEN u.billing_detail->'inputs'->>'semantics' = 'inclusive' THEN u.input_tokens
		WHEN u.billing_detail->'inputs'->>'semantics' IN ('exclusive', '') THEN
			u.input_tokens + u.cache_read_tokens + u.cache_creation_tokens + u.cache_creation_1h_tokens
		END, 0)), sum(CASE WHEN ((u.anomalies - 'usage_extract' - 'failure_policy' - 'availability' - 'scheduling' - 'attempts') <> '{}'::jsonb OR (u.anomalies ? 'usage_extract' AND u.anomalies->>'usage_extract' <> 'plugin')) THEN 1 ELSE 0 END), sum(CASE WHEN u.anomalies->>'reconcile' IN ('abandoned', 'estimated') THEN 1 ELSE 0 END), sum(CASE WHEN u.anomalies->>'reconcile' IN ('abandoned', 'estimated') THEN u.total_cost ELSE 0 END), sum(CASE WHEN u.success AND u.latency_ms > 0 THEN u.latency_ms ELSE 0 END), sum(CASE WHEN u.success AND u.latency_ms > 0 THEN 1 ELSE 0 END), sum(CASE WHEN u.success AND u.first_token_ms > 0 THEN u.first_token_ms ELSE 0 END), sum(CASE WHEN u.success AND u.first_token_ms > 0 THEN 1 ELSE 0 END)
		FROM usage_logs u WHERE u.created_at >= $1 AND u.created_at < $2
		GROUP BY 1, user_id, api_key_id, group_id, account_id, model, upstream_model, protocol, platform
-- vars
$1 time.Time 2026-11-15 12:00:00 +0000 UTC
$2 time.Time 2026-11-15 13:00:00 +0000 UTC
