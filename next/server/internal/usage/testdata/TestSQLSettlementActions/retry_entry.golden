-- sql
UPDATE "pending_settlements" SET "attempts"=$1,"deadline_at"=$2,"last_error"=$3,"next_check_at"=$4,"poll_failures"=$5,"state"=$6 WHERE id = $7
-- vars
$1 int 0
$2 time.Time 2026-11-15 09:00:00 +0000 UTC
$3 string ""
$4 time.Time 2026-11-15 08:00:00 +0000 UTC
$5 int 0
$6 string "pending"
$7 int64 9
