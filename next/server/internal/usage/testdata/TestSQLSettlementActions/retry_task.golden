-- sql
UPDATE "async_tasks" SET "attempts"=$1,"claim_token"=$2,"deadline_at"=$3,"failure_code"=$4,"last_error"=$5,"lease_until"=$6,"next_check_at"=$7,"observation_status"=$8,"poll_failures"=$9 WHERE usage_log_id = $10
-- vars
$1 int 0
$2 string ""
$3 time.Time 2026-11-15 09:00:00 +0000 UTC
$4 string ""
$5 string ""
$6 nil
$7 time.Time 2026-11-15 08:00:00 +0000 UTC
$8 string "pending"
$9 int 0
$10 int64 5
