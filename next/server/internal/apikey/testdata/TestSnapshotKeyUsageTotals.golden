-- sql
SELECT
		count(*) FILTER (WHERE created_at >= $1), count(*),
		COALESCE(sum(input_tokens) FILTER (WHERE created_at >= $2), 0), COALESCE(sum(input_tokens), 0),
		COALESCE(sum(output_tokens) FILTER (WHERE created_at >= $3), 0), COALESCE(sum(output_tokens), 0),
		COALESCE(sum(cache_creation_tokens + cache_creation_1h_tokens) FILTER (WHERE created_at >= $4), 0),
		COALESCE(sum(cache_creation_tokens + cache_creation_1h_tokens), 0),
		COALESCE(sum(cache_read_tokens) FILTER (WHERE created_at >= $5), 0), COALESCE(sum(cache_read_tokens), 0),
		COALESCE(sum(apikey_quota_charge(billing_status, total_cost)) FILTER (WHERE created_at >= $6), 0),
		COALESCE(sum(apikey_quota_charge(billing_status, total_cost)), 0)
	FROM usage_logs WHERE api_key_id = $7
-- vars
$1 time.Time 2026-11-15 00:00:00 +0000 UTC
$2 time.Time 2026-11-15 00:00:00 +0000 UTC
$3 time.Time 2026-11-15 00:00:00 +0000 UTC
$4 time.Time 2026-11-15 00:00:00 +0000 UTC
$5 time.Time 2026-11-15 00:00:00 +0000 UTC
$6 time.Time 2026-11-15 00:00:00 +0000 UTC
$7 int64 5
