-- sql
SELECT count(*) FROM api_keys k JOIN users u ON u.id = k.user_id WHERE (k.deleted_at IS NULL AND k.user_id = $1) AND ((k.name ILIKE $2 OR k.key_prefix ILIKE $3)) AND (k.status = 'active' AND (k.expires_at IS NULL OR k.expires_at > now())) AND k.group_id = $4
-- vars
$1 int64 7
$2 string "%sk-s2a-AbCdEfGh%"
$3 string "sk-s2a-AbCdE%"
$4 int64 3
