-- sql
SELECT true FROM groups g WHERE g.id = $1 AND (g.status = 'active' AND (g.visibility = 'public' OR EXISTS (SELECT 1 FROM segment_groups sg
		JOIN users su ON su.segment_id = sg.segment_id
		WHERE sg.group_id = g.id AND sg.granted AND su.id = $2))) LIMIT $3 FOR KEY SHARE OF "g"
-- vars
$1 int64 3
$2 int64 7
$3 int 1
