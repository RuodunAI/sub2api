-- sql
INSERT INTO "segment_groups" ("granted","group_id","rate_override","segment_id") VALUES (COALESCE($1, false),$2,$3::numeric,$4) ON CONFLICT ("segment_id","group_id") DO UPDATE SET "granted"=COALESCE($5, segment_groups.granted),"rate_override"=CASE WHEN $6 THEN $7::numeric ELSE segment_groups.rate_override END,"updated_at"=now()
-- vars
$1 *bool nil
$2 int64 4
$3 *decimal.Decimal 0.8
$4 int64 3
$5 *bool nil
$6 bool true
$7 *decimal.Decimal 0.8
