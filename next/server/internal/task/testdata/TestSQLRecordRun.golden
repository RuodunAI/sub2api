-- sql
UPDATE scheduled_tasks SET
			lease_job_id = CASE WHEN lease_job_id = $1 THEN NULL ELSE lease_job_id END,
			lease_node = CASE WHEN lease_job_id = $2 THEN NULL ELSE lease_node END,
			lease_until = CASE WHEN lease_job_id = $3 THEN NULL ELSE lease_until END,
			last_job_id = $4, last_node = $5, last_finished_at = clock_timestamp(), last_status = $6,
			last_count = $7, last_message = NULLIF($8, ''), last_error = NULLIF($9, ''),
			last_success_at = CASE WHEN $10 = 'succeeded' THEN clock_timestamp() ELSE last_success_at END,
			consecutive_failures = CASE WHEN $11 = 'succeeded' THEN 0 WHEN $12 = 'skipped' THEN consecutive_failures
				ELSE consecutive_failures + 1 END,
			updated_at = clock_timestamp()
		WHERE name = $13
-- vars
$1 int64 42
$2 int64 42
$3 int64 42
$4 int64 42
$5 string "node-a"
$6 string "failed"
$7 int 3
$8 string ""
$9 string "upstream down"
$10 string "failed"
$11 string "failed"
$12 string "failed"
$13 string "core.test.bad"
