-- sql
SELECT a.id AS id, a.name AS name, a.plugin_key AS hint, a.status AS status FROM accounts a WHERE a.deleted_at IS NULL AND (($1::boolean OR COALESCE(a.owner_id = ANY($2::bigint[]) OR a.owner_id IN (SELECT "id" FROM "users" WHERE "owner_path" && $3), false) OR a.id = ANY($4::bigint[]) OR EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ($5::boolean OR ag.group_id = ANY($6::bigint[]))) OR EXISTS (SELECT 1 FROM account_groups ag JOIN unnest($7::bigint[], $8::bigint[]) sp(g, x) ON sp.x = ag.account_id AND (sp.g = 0 OR sp.g = ag.group_id) WHERE ag.account_id = a.id))) ORDER BY (EXISTS (SELECT 1 FROM account_groups ag WHERE ag.account_id = a.id AND ag.group_id = $9)) DESC, a.name, a.id LIMIT $10
-- vars
$1 bool false
$2 core.int64s [7]
$3 gormpg.Array[int64] []
$4 core.int64s [5]
$5 bool true
$6 core.int64s [3]
$7 core.int64s []
$8 core.int64s []
$9 int64 3
$10 int 11
