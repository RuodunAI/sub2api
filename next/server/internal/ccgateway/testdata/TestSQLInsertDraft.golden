-- sql
INSERT INTO ccgateway_runtimes(key, proxy_id, created_by)
			SELECT $1, $2, NULLIF($3::bigint, 0)
			WHERE $4::int = 0 OR (SELECT count(*) FROM ccgateway_runtimes
				WHERE created_by = $5 AND account_id IS NULL AND retired_at IS NULL) < $6
-- vars
$1 string "d0123456789abcdef"
$2 *int64 4
$3 int64 9
$4 int 5
$5 int64 9
$6 int 5
